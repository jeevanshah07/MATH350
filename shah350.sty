\newenvironment{amatrix}[1]{%
  \left(\begin{array}{@{}*{#1}{c}|c@{}}
}{%
  \end{array}\right)
}

\newenvironment{Lamatrix}[2]{%
  % #1 = total columns, #2 = split position (vertical line after #2-th column)
  \left(\begin{array}{@{}*{\the\numexpr#2\relax}{c}|*{\the\numexpr#1-#2\relax}{c}@{}}%
}{%
  \end{array}\right)
}

